# Copy this file to .env and adjust as needed. docker-compose reads it automatically.

# --- Django ---
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*
CORS_ALLOW_ALL=true

# --- Postgres ---
POSTGRES_DB=cloudcost
POSTGRES_USER=cloudcost
POSTGRES_PASSWORD=cloudcost
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Celery / Redis ---
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --- Cloud data source ---
# true (default): every connector returns realistic synthetic data, no
# cloud credentials needed at all. Set to false only once you have real
# AWS/Azure/GCP billing API credentials to fill in below.
USE_MOCK_CLOUD_DATA=true

# AWS Cost Explorer (only used when USE_MOCK_CLOUD_DATA=false)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Azure Cost Management (only used when USE_MOCK_CLOUD_DATA=false)
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# GCP Billing export to BigQuery (only used when USE_MOCK_CLOUD_DATA=false)
GCP_BILLING_ACCOUNT_ID=
GCP_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# --- ML / FinOps tuning ---
ANOMALY_CONTAMINATION=0.05
FORECAST_HORIZON_DAYS=14
RIGHTSIZING_UTILIZATION_THRESHOLD=35

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api
